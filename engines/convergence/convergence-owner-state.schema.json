{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro://schemas/convergence-owner-state/v1",
  "title": "Cerebro Convergence Owner State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state_ref", "basis_fingerprint", "work_families", "state_fingerprint"],
  "properties": {
    "schema": {"const": "cerebro-convergence-owner-state/v1"},
    "state_ref": {"type": "string", "minLength": 1},
    "basis_fingerprint": {"$ref": "#/$defs/sha256"},
    "work_families": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/work_family"}
    },
    "state_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "state", "depends_on", "pass_basis_fingerprint", "invalidated_by"],
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["PENDING", "READY", "IN_PROGRESS", "PASS", "BLOCKED", "STALE"]},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "pass_basis_fingerprint": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "invalidated_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
