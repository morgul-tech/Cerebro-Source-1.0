{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro://schemas/control-context-state/v1",
  "title": "Cerebro Project Context and Control Session State",
  "oneOf": [
    {"$ref": "#/$defs/project_state"},
    {"$ref": "#/$defs/session_state"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "aggregate_id",
        "tenant_ref",
        "workspace_ref",
        "project_ref",
        "source_revision",
        "project_status",
        "revision",
        "default_context_ref",
        "contexts",
        "next_sequence",
        "fingerprint"
      ],
      "properties": {
        "schema": {"const": "cerebro-control-context-project-state/v1"},
        "aggregate_id": {"type": "string", "minLength": 1},
        "tenant_ref": {"type": "string", "minLength": 1},
        "workspace_ref": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "project_status": {"enum": ["ACTIVE", "PAUSED", "BLOCKED", "COMPLETED", "CANCELLED"]},
        "revision": {"type": "integer", "minimum": 1},
        "default_context_ref": {"type": ["string", "null"]},
        "contexts": {"type": "array", "items": {"$ref": "#/$defs/control_context"}},
        "next_sequence": {"type": "integer", "minimum": 2},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "session_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "session_binding_id",
        "tenant_ref",
        "workspace_ref",
        "principal_ref",
        "consumer_ref",
        "session_ref",
        "project_ref",
        "project_revision",
        "session_revision",
        "active_context_ref",
        "active_continuation_binding",
        "fingerprint"
      ],
      "properties": {
        "schema": {"const": "cerebro-control-session-state/v1"},
        "session_binding_id": {"type": "string", "minLength": 1},
        "tenant_ref": {"type": "string", "minLength": 1},
        "workspace_ref": {"type": "string", "minLength": 1},
        "principal_ref": {"type": "string", "minLength": 1},
        "consumer_ref": {"type": "string", "minLength": 1},
        "session_ref": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "minLength": 1},
        "project_revision": {"type": "integer", "minimum": 1},
        "session_revision": {"type": "integer", "minimum": 1},
        "active_context_ref": {"type": ["string", "null"]},
        "active_continuation_binding": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/continuation_binding"}]
        },
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "control_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "context_id",
        "project_ref",
        "parent_context_ref",
        "derived_from_context_ref",
        "human_label",
        "objective_ref",
        "scope_ref",
        "basis_refs",
        "project_basis_ref",
        "quality_trace_ref",
        "lifecycle",
        "control_condition",
        "disposition",
        "completion_criteria_refs",
        "result_ref",
        "return_target_ref",
        "created_from_event_ref",
        "last_transition_ref",
        "basis_fingerprint",
        "sequence",
        "context_fingerprint"
      ],
      "properties": {
        "schema": {"const": "cerebro-control-context/v1"},
        "context_id": {"type": "string", "minLength": 1},
        "project_ref": {"type": "string", "minLength": 1},
        "parent_context_ref": {"type": ["string", "null"]},
        "derived_from_context_ref": {"type": ["string", "null"]},
        "human_label": {"type": "string", "minLength": 1},
        "objective_ref": {"type": "string", "minLength": 1},
        "scope_ref": {"type": "string", "minLength": 1},
        "basis_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "project_basis_ref": {"type": ["string", "null"]},
        "quality_trace_ref": {"type": ["string", "null"]},
        "lifecycle": {"enum": ["OPEN", "RETURNED", "CLOSED", "CANCELLED"]},
        "control_condition": {
          "enum": ["READY", "PAUSED_BY_USER", "WAITING_HUMAN", "STALLED", "SAFE_HOLD", null]
        },
        "disposition": {
          "enum": ["NONE", "PENDING_JOIN", "INCORPORATED", "PRESERVED", "SUPERSEDED", null]
        },
        "completion_criteria_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "result_ref": {"type": ["string", "null"]},
        "return_target_ref": {"type": ["string", "null"]},
        "created_from_event_ref": {"type": "string", "minLength": 1},
        "last_transition_ref": {"type": ["string", "null"]},
        "basis_fingerprint": {"$ref": "#/$defs/sha256"},
        "sequence": {"type": "integer", "minimum": 1},
        "context_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "continuation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "binding_id",
        "surface_kind",
        "alias",
        "operation",
        "target_ref",
        "context_ref",
        "basis_project_revision",
        "basis_session_revision",
        "binding_revision",
        "binding_fingerprint"
      ],
      "properties": {
        "schema": {"const": "cerebro-control-continuation-binding/v1"},
        "binding_id": {"type": "string", "minLength": 1},
        "surface_kind": {"enum": ["HNS", "HCS"]},
        "alias": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "target_ref": {"type": "string", "minLength": 1},
        "context_ref": {"type": "string", "minLength": 1},
        "basis_project_revision": {"type": "integer", "minimum": 1},
        "basis_session_revision": {"type": "integer", "minimum": 1},
        "binding_revision": {"type": "integer", "minimum": 1},
        "binding_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
