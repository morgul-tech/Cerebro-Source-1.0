{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro://schemas/context-consolidation-result/v1",
  "title": "Cerebro Context Consolidation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "message_kind", "producer_ref", "authority", "subject_ref", "correlation_ref",
    "event_ref", "selected_contexts", "join_target_project_ref", "join_target_candidate_ref",
    "structural_join_requested", "synthesis_ref", "evidence_refs", "material_conflicts",
    "branch_disposition_candidates", "effect_candidates", "partial_join",
    "automatic_control_decision", "automatic_state_mutation", "requires_canonical_mcp_owner_routing",
    "basis_fingerprint", "result_ref"
  ],
  "properties": {
    "schema": {"const": "cerebro-context-consolidation-result/v1"},
    "message_kind": {"const": "CONTEXT_CONSOLIDATION_RESULT"},
    "producer_ref": {"const": "interaction"},
    "authority": {"const": "DERIVED_ASSESSMENT"},
    "subject_ref": {"const": "selected-control-contexts"},
    "correlation_ref": {"type": "string", "minLength": 1},
    "event_ref": {"type": "string", "minLength": 1},
    "selected_contexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/snapshot"}},
    "join_target_project_ref": {"type": ["string", "null"]},
    "join_target_candidate_ref": {"type": ["string", "null"]},
    "structural_join_requested": {"type": "boolean"},
    "synthesis_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "material_conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "branch_disposition_candidates": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "effect_candidates": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": [
        "CONTEXT_ENRICHMENT", "PROJECT_REVISION_REQUIRED", "QUALITY_INVALIDATION_REQUIRED",
        "CONVERGENCE_REVALIDATION_REQUIRED", "HUMAN_DECISION_REQUIRED"
      ]}
    },
    "partial_join": {"type": "boolean"},
    "automatic_control_decision": {"const": false},
    "automatic_state_mutation": {"const": false},
    "requires_canonical_mcp_owner_routing": {"const": true},
    "basis_fingerprint": {"$ref": "#/$defs/sha256"},
    "result_ref": {"type": "string", "pattern": "^CCR-[0-9A-F]{24}$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["project_ref", "project_revision", "project_fingerprint", "context_ref", "context_fingerprint", "lifecycle", "disposition"],
      "properties": {
        "project_ref": {"type": "string", "minLength": 1},
        "project_revision": {"type": "integer", "minimum": 1},
        "project_fingerprint": {"$ref": "#/$defs/sha256"},
        "context_ref": {"type": "string", "minLength": 1},
        "context_fingerprint": {"$ref": "#/$defs/sha256"},
        "lifecycle": {"enum": ["OPEN", "RETURNED", "CLOSED", "CANCELLED"]},
        "disposition": {"enum": ["NONE", "PENDING_JOIN", "INCORPORATED", "PRESERVED", "SUPERSEDED", null]}
      }
    },
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["project_ref", "context_ref", "candidate", "application_authorized", "requires_return_before_application", "requires_current_dependent_owner_state"],
      "properties": {
        "project_ref": {"type": "string", "minLength": 1},
        "context_ref": {"type": "string", "minLength": 1},
        "candidate": {"enum": ["INCORPORATED", "PRESERVED", "SUPERSEDED", "PENDING_JOIN"]},
        "application_authorized": {"const": false},
        "requires_return_before_application": {"type": "boolean"},
        "requires_current_dependent_owner_state": {"type": "boolean"}
      }
    }
  }
}
