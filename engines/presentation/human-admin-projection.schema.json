{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro-human-admin-projection.schema.json",
  "title": "Cerebro Human Admin Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "projection_ref",
    "projection_revision",
    "projection_fingerprint",
    "source_revision",
    "currentness",
    "basis_set",
    "coverage",
    "unknowns",
    "orientation",
    "current_objective",
    "return_points",
    "human_cognitive_location",
    "blockers",
    "next_human_gate",
    "active_work",
    "human_label",
    "human_surface",
    "waiting_input",
    "room_identity",
    "role_assessment",
    "responsibility_assessment",
    "human_boundary_assessment",
    "presentation_request",
    "hmi",
    "causal_transitions",
    "material_unknowns",
    "objects",
    "evidence_refs",
    "n0"
  ],
  "properties": {
    "schema": {
      "const": "cerebro-human-admin-projection/v1"
    },
    "authority": {
      "const": "PRESENTATION_ONLY_NON_AUTHORITATIVE"
    },
    "projection_ref": {
      "type": "string",
      "minLength": 1
    },
    "projection_revision": {
      "type": "integer",
      "minimum": 0
    },
    "projection_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "currentness": {
      "enum": [
        "CURRENT",
        "STALE",
        "GAP",
        "UNKNOWN",
        "PROVISIONAL"
      ]
    },
    "basis_set": {
      "type": "array"
    },
    "coverage": {
      "type": "object"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "orientation": {
      "type": "object"
    },
    "current_objective": {
      "type": "string"
    },
    "return_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_cognitive_location": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_human_gate": {
      "type": "string"
    },
    "active_work": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[^\\s]+(?:\\s+[^\\s]+){0,2}$"
    },
    "human_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "human_action",
        "human_transport_required",
        "human_decision_required",
        "next_machine",
        "next_owner",
        "attention"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "human_action": {
          "type": "string",
          "minLength": 1
        },
        "human_transport_required": {
          "type": "string",
          "minLength": 1
        },
        "human_decision_required": {
          "type": "string",
          "minLength": 1
        },
        "next_machine": {
          "type": "string",
          "minLength": 1
        },
        "next_owner": {
          "type": "string",
          "minLength": 1
        },
        "attention": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "waiting_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "next_owner_label",
        "dependency_labels",
        "human_action_required"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "next_owner_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependency_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_action_required": {
          "const": false
        }
      }
    },
    "room_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "active",
        "membership_semantics",
        "source",
        "durable_room_id",
        "room_name",
        "color_derivation",
        "derived_color_storage",
        "encodes_status_or_authority"
      ],
      "properties": {
        "type": {
          "const": "ROOM_IDENTITY"
        },
        "active": {
          "type": "boolean"
        },
        "membership_semantics": {
          "const": "MEMBERSHIP_ONLY"
        },
        "source": {
          "enum": [
            "NONE",
            "ROOM_ID",
            "CASE_CONTAINER_ID",
            "ROOM_ID_OR_CASE_CONTAINER_ID"
          ]
        },
        "durable_room_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "room_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 48
        },
        "color_derivation": {
          "const": "SHA256_FIXED_PALETTE_AT_RENDER"
        },
        "derived_color_storage": {
          "const": "NONE"
        },
        "encodes_status_or_authority": {
          "const": false
        }
      }
    },
    "role_assessment": {
      "type": "object"
    },
    "responsibility_assessment": {
      "type": "object"
    },
    "human_boundary_assessment": {
      "type": "object"
    },
    "presentation_request": {
      "type": "object"
    },
    "hmi": {
      "type": "object",
      "required": [
        "surface_first",
        "machine_route_before_human_relay",
        "ha_expansion",
        "actor_identity_mutation_allowed",
        "room_header_at_absolute_top",
        "room_color_membership_only",
        "derived_room_color_persisted",
        "human_label_primary",
        "opaque_ids_brief_standard",
        "waiting_default_max_lines",
        "waiting_is_human_pulse"
      ],
      "properties": {
        "surface_first": {
          "const": true
        },
        "machine_route_before_human_relay": {
          "const": true
        },
        "ha_expansion": {
          "const": "HUMAN_ADMIN"
        },
        "actor_identity_mutation_allowed": {
          "const": false
        },
        "room_header_at_absolute_top": {
          "const": true
        },
        "room_color_membership_only": {
          "const": true
        },
        "derived_room_color_persisted": {
          "const": false
        },
        "human_label_primary": {
          "const": true
        },
        "opaque_ids_brief_standard": {
          "const": "HIDDEN"
        },
        "waiting_default_max_lines": {
          "const": 3
        },
        "waiting_is_human_pulse": {
          "const": false
        }
      }
    },
    "objects": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "n0": {
      "type": "object"
    },
    "causal_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "transition_ref",
          "claim_ref",
          "actor_generation_ref",
          "lifecycle",
          "allocation_receipt_ref",
          "allocation_receipt_fingerprint",
          "provider_ref",
          "provider_frontier_ref",
          "provider_revision",
          "authority"
        ],
        "properties": {
          "schema": {
            "const": "cerebro-hap-causal-transition/v1"
          },
          "transition_ref": {
            "type": "string",
            "minLength": 1
          },
          "claim_ref": {
            "type": "string",
            "minLength": 1
          },
          "actor_generation_ref": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "allocation_receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "allocation_receipt_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provider_ref": {
            "type": "string",
            "minLength": 1
          },
          "provider_frontier_ref": {
            "type": "string",
            "minLength": 1
          },
          "provider_revision": {
            "type": "integer",
            "minimum": 0
          },
          "authority": {
            "const": "DERIVED_PRESENTATION_ONLY"
          }
        }
      }
    },
    "material_unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "context_ref",
          "work_ref",
          "claim_ref",
          "owner_ref",
          "basis_fingerprint",
          "unknown_fingerprint",
          "reopen_condition",
          "required_evidence_delta_ref",
          "release_route_ref",
          "late_receipt_route_ref",
          "provider_frontier_ref",
          "provider_revision",
          "frame_strain_evidence_refs",
          "authority"
        ],
        "properties": {
          "schema": {
            "const": "cerebro-hap-material-unknown/v1"
          },
          "context_ref": {
            "type": "string",
            "minLength": 1
          },
          "work_ref": {
            "type": "string",
            "minLength": 1
          },
          "claim_ref": {
            "type": "string",
            "minLength": 1
          },
          "owner_ref": {
            "type": "string",
            "minLength": 1
          },
          "basis_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "unknown_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reopen_condition": {
            "type": "string",
            "minLength": 1
          },
          "required_evidence_delta_ref": {
            "type": "string",
            "minLength": 1
          },
          "release_route_ref": {
            "type": "string",
            "minLength": 1
          },
          "late_receipt_route_ref": {
            "type": "string",
            "minLength": 1
          },
          "provider_frontier_ref": {
            "type": "string",
            "minLength": 1
          },
          "provider_revision": {
            "type": "integer",
            "minimum": 0
          },
          "frame_strain_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authority": {
            "const": "DERIVED_PRESENTATION_ONLY"
          }
        }
      }
    }
  }
}
