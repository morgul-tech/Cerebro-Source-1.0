{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro-native-live-shadow-projection/v1",
  "title": "Cerebro Native Live Shadow Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "projection_state",
    "stream_ref",
    "stream_revision",
    "runtime_evidence",
    "basis_set",
    "delivery_state",
    "projection_fingerprint"
  ],
  "properties": {
    "schema": {
      "const": "cerebro-native-live-shadow-projection/v1"
    },
    "authority": {
      "const": "PRESENTATION_ONLY_NON_AUTHORITATIVE"
    },
    "projection_state": {
      "enum": [
        "CURRENT",
        "STALE",
        "GAP",
        "UNKNOWN",
        "PROVISIONAL"
      ]
    },
    "stream_ref": {
      "type": "string",
      "minLength": 1
    },
    "stream_revision": {
      "type": "integer",
      "minimum": 0
    },
    "runtime_evidence": {
      "type": "object",
      "required": [
        "ref",
        "fingerprint",
        "schema"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "basis_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_ref",
          "stream_ref",
          "revision",
          "fingerprint",
          "currentness"
        ],
        "properties": {
          "owner_ref": {
            "type": "string",
            "minLength": 1
          },
          "stream_ref": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "currentness": {
            "enum": [
              "CURRENT",
              "STALE",
              "GAP",
              "UNKNOWN",
              "PROVISIONAL"
            ]
          }
        }
      }
    },
    "delivery_state": {
      "enum": [
        "OBSERVED",
        "NO_RESPONSE",
        "REJECTED",
        "FAIL"
      ]
    },
    "projection_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
