{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro-failure-knowledge/v0.2",
  "type": "object",
  "required": [
    "schema",
    "generation",
    "events",
    "families",
    "successes",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "cerebro-failure-knowledge/v0.2"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "classification",
          "family",
          "observed_at",
          "source"
        ]
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "observations",
          "distinct_runs",
          "status",
          "prevention_refs",
          "regression_refs"
        ],
        "properties": {
          "observations": {
            "type": "integer",
            "minimum": 0
          },
          "distinct_runs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "OBSERVED",
              "SYSTEMIC_SUSPECTED",
              "MITIGATED",
              "RESOLVED"
            ]
          },
          "prevention_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regression_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "successes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "type": "object"
    },
    "control_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "candidate_fingerprint",
        "selected_needs",
        "executed",
        "reused",
        "rejected",
        "uncovered",
        "catalog_role",
        "proof_ceiling"
      ],
      "properties": {
        "schema": {
          "const": "cerebro-control-coverage/v1"
        },
        "candidate_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selected_needs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control_id",
              "reason",
              "context",
              "state",
              "evidence_refs"
            ],
            "properties": {
              "control_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "object",
                "minProperties": 1
              },
              "state": {
                "enum": [
                  "EXECUTED",
                  "REUSED_VALID",
                  "UNCOVERED"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "executed": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reused": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "uncovered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "catalog_role": {
          "type": "string"
        },
        "proof_ceiling": {
          "type": "string"
        }
      }
    }
  }
}
