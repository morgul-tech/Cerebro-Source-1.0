{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro://schemas/control-context-remote-service-config/v1",
  "title": "Cerebro control-context remote MCP service configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "resource",
    "authorization_servers",
    "resource_documentation",
    "service_name",
    "service_version",
    "identity_claims",
    "transport",
    "paths"
  ],
  "properties": {
    "schema": {"const": "cerebro-control-context-remote-mcp-service-config/v1"},
    "resource": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"},
    "authorization_servers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    },
    "resource_documentation": {"type": "string", "format": "uri", "pattern": "^https://"},
    "service_name": {"type": "string", "minLength": 1},
    "service_version": {"type": "string", "minLength": 1},
    "identity_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "workspace", "principal"],
      "properties": {
        "tenant": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "principal": {"type": "string", "minLength": 1}
      }
    },
    "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
    "transport": {"const": "STREAMABLE_HTTP"},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp", "protected_resource_metadata", "health"],
      "properties": {
        "mcp": {"const": "/mcp"},
        "protected_resource_metadata": {"const": "/.well-known/oauth-protected-resource"},
        "health": {"const": "/healthz"}
      }
    }
  }
}
