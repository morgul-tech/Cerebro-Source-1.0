{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro://schemas/owner-state-commit-receipt/v1",
  "title": "Cerebro Owner State Commit Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "message_kind", "backend", "commit_kind", "commit_protocol", "durability",
    "tenant_ref", "workspace_ref", "principal_ref", "consumer_ref", "session_ref",
    "project_ref", "owner", "aggregate_ref", "event_id", "idempotency_key",
    "request_fingerprint", "owner_revision_before", "owner_revision_after",
    "input_state_ref", "input_state_fingerprint", "output_state_ref",
    "output_state_fingerprint", "state_schema", "owner_effect_candidate_ref",
    "owner_effect_candidate_fingerprint", "commit_fingerprint", "commit_ref"
  ],
  "properties": {
    "schema": {"const": "cerebro-owner-state-commit-receipt/v1"},
    "message_kind": {"const": "OWNER_STATE_COMMIT_RECEIPT"},
    "backend": {"const": "POSTGRESQL"},
    "commit_kind": {"enum": ["INITIALIZE", "OWNER_EFFECT"]},
    "commit_protocol": {"const": "RETURN_ONLY_AFTER_DATABASE_COMMIT"},
    "durability": {"const": "DATABASE_COMMIT_ACKNOWLEDGED_ON_RETURN"},
    "tenant_ref": {"type": "string", "minLength": 1},
    "workspace_ref": {"type": "string", "minLength": 1},
    "principal_ref": {"type": "string", "minLength": 1},
    "consumer_ref": {"type": "string", "minLength": 1},
    "session_ref": {"type": "string", "minLength": 1},
    "project_ref": {"type": "string", "minLength": 1},
    "owner": {"enum": ["project", "quality", "convergence"]},
    "aggregate_ref": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "request_fingerprint": {"$ref": "#/$defs/sha256"},
    "owner_revision_before": {"type": "integer", "minimum": 0},
    "owner_revision_after": {"type": "integer", "minimum": 1},
    "input_state_ref": {"type": ["string", "null"], "minLength": 1},
    "input_state_fingerprint": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "output_state_ref": {"type": "string", "minLength": 1},
    "output_state_fingerprint": {"$ref": "#/$defs/sha256"},
    "state_schema": {"type": "string", "minLength": 1},
    "owner_effect_candidate_ref": {"type": ["string", "null"], "minLength": 1},
    "owner_effect_candidate_fingerprint": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "commit_fingerprint": {"$ref": "#/$defs/sha256"},
    "commit_ref": {"type": "string", "pattern": "^OSC-[0-9A-F]{24}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"commit_kind": {"const": "INITIALIZE"}}},
      "then": {
        "properties": {
          "owner_revision_before": {"const": 0},
          "owner_revision_after": {"const": 1},
          "input_state_ref": {"type": "null"},
          "input_state_fingerprint": {"type": "null"},
          "owner_effect_candidate_ref": {"type": "null"},
          "owner_effect_candidate_fingerprint": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "owner_revision_before": {"type": "integer", "minimum": 1},
          "input_state_ref": {"type": "string", "minLength": 1},
          "input_state_fingerprint": {"$ref": "#/$defs/sha256"},
          "owner_effect_candidate_ref": {"type": "string", "pattern": "^OER-[0-9A-F]{24}$"},
          "owner_effect_candidate_fingerprint": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
