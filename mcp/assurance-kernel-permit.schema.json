{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cerebro-assurance-kernel-permit/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","permit_id","campaign_id","package_class","source_pre_head","package_sha256","touched_paths_sha256","nonce","authority_epoch"],
  "properties": {
    "schema": {"const": "cerebro-assurance-kernel-permit/v1"},
    "permit_id": {"type":"string","minLength":1},
    "campaign_id": {"type":"string","minLength":1},
    "package_class": {"type":"string","minLength":1},
    "source_pre_head": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "package_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "touched_paths_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nonce": {"type":"string","minLength":16},
    "authority_epoch": {"type":"integer","minimum":1},
    "doctor_receipt_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "doctor_trust_object_path": {"type":"string","minLength":1}
  }
}
