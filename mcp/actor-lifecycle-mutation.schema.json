{
  "$id": "cerebro://schemas/actor-lifecycle-mutation/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_generation_id": {
      "minLength": 1,
      "type": "string"
    },
    "authority_source": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "claim_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_claim_revision": {
      "oneOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "const": "NOT_APPLICABLE"
        }
      ]
    },
    "expected_lifecycle_revision": {
      "minimum": 0,
      "type": "integer"
    },
    "expected_lifecycle_state": {
      "minLength": 1,
      "type": "string"
    },
    "expected_slot_pointer": {
      "minLength": 1,
      "type": "string"
    },
    "observed_slot_pointer": {
      "minLength": 1,
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "mutation_id": {
      "minLength": 1,
      "type": "string"
    },
    "observed_event_frontier": {
      "minimum": 0,
      "type": "integer"
    },
    "operation": {
      "enum": [
        "RETIRE",
        "BIND",
        "START"
      ]
    },
    "packet_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "const": "cerebro-actor-lifecycle-mutation/v1"
    },
    "slot_pointer_ref": {
      "minLength": 1,
      "type": "string"
    },
    "source_transition": {
      "additionalProperties": false,
      "properties": {
        "actor_nonretired_verified": {
          "const": true
        },
        "boot_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "changed_contracts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "current_source_verified": {
          "const": true
        },
        "gates_rerun": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "generation_pointer_verified": {
          "const": true
        },
        "intent": {
          "const": "SAME_GENERATION_SOURCE_REQUALIFICATION"
        },
        "no_active_claim_verified": {
          "const": true
        },
        "prerequisite_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "previous_source_head": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "target_source_head": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "previous_source_head",
        "target_source_head",
        "changed_contracts",
        "gates_rerun",
        "prerequisite_fingerprint",
        "boot_fingerprint",
        "current_source_verified",
        "actor_nonretired_verified",
        "no_active_claim_verified",
        "generation_pointer_verified"
      ],
      "type": "object"
    },
    "effect_evidence": {
      "additionalProperties": false,
      "properties": {
        "context_commit_result": {
          "const": "COMMITTED"
        },
        "durable": {
          "const": true
        },
        "post_actor_generation_id": {
          "minLength": 1,
          "type": "string"
        },
        "post_lifecycle_state": {
          "const": "READY_CURRENT"
        },
        "post_source_head": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "post_state_readback_verified": {
          "const": true
        },
        "provider_revision": {
          "minimum": 0,
          "type": "integer"
        },
        "receipt_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "receipt_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "context_commit_result",
        "durable",
        "post_state_readback_verified",
        "post_actor_generation_id",
        "post_lifecycle_state",
        "post_source_head",
        "provider_revision",
        "receipt_fingerprint"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema",
    "mutation_id",
    "idempotency_key",
    "operation",
    "actor_generation_id",
    "slot_pointer_ref",
    "expected_slot_pointer",
    "expected_lifecycle_revision",
    "expected_lifecycle_state",
    "expected_claim_revision",
    "packet_ref",
    "claim_ref",
    "authority_source",
    "observed_event_frontier",
    "candidate_fingerprint"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "source_transition"
        ]
      },
      "then": {
        "properties": {
          "claim_ref": {
            "type": "null"
          },
          "expected_claim_revision": {
            "const": "NOT_APPLICABLE"
          },
          "expected_lifecycle_state": {
            "const": "REQUALIFICATION_REQUIRED"
          },
          "operation": {
            "const": "BIND"
          }
        },
        "required": [
          "observed_slot_pointer"
        ]
      }
    },
    {
      "if": {
        "required": [
          "effect_evidence"
        ]
      },
      "then": {
        "required": [
          "source_transition"
        ]
      }
    }
  ],
  "title": "Cerebro Actor Lifecycle Mutation Candidate",
  "type": "object"
}
