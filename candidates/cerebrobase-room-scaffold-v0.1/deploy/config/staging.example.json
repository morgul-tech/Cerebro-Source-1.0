{
 "config_schema": "cerebrobase.config/v1",
 "environment": "STAGING",
 "build_id": "<16-hex build_id from the installed artifact BUILD_INFO.json>",
 "db_path": "/srv/cerebrobase-staging/data/db/rooms.sqlite3",
 "private_data_root": "/srv/cerebrobase-staging/data/private",
 "public_assets_root": "/srv/cerebrobase-staging/public",
 "runtime_root": "/srv/cerebrobase-staging/run",
 "bind_host": "127.0.0.1",
 "port": 8472,
 "public_origin": "http://127.0.0.1:8472",
 "auth_mode": "SYNTHETIC",
 "cookie_secure": false,
 "session_ttl_seconds": 3600,
 "capabilities": {"tools": {"fixture.echo": true}},
 "integrations": {"postkasse": {"enabled": false, "secret_ref": "postkasse_token"}},
 "secret_refs": {"postkasse_token": "file:/etc/cerebrobase-staging/secrets/postkasse_token"},
 "production_roots": {"db_path": "/srv/cerebrobase-prod/data/db/rooms.sqlite3",
                      "private_data_root": "/srv/cerebrobase-prod/data/private",
                      "runtime_root": "/srv/cerebrobase-prod/run",
                      "public_main_root": "/srv/cerebro/www"},
 "limits": {"max_body_bytes": 16384, "rate_per_minute": 240, "max_header_bytes": 8192},
 "min_free_bytes": 268435456
}
