    "effect_class",
    "reply_to",
    "requires_ack",
    "payload_ref",
    "payload_hash"
  ],
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "message_type": {
      "enum": [
        "EPHEMERAL_SIGNAL",
        "REQUEST",
        "RESPONSE",
        "DURABLE_COMMAND",
        "STATE_DELTA",
        "ARTIFACT_POINTER",
        "PRESENCE",
        "RECEIPT",
        "HUMAN_NOTICE"
      ]
    },
    "schema_version": { "const": "1.0.0-draft" },
    "subject": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_ref",
        "actor_id",
        "generation",
        "workload_ref",
        "machine_ref",
        "session_ref",
        "custody_ref"
      ],
      "properties": {
        "principal_ref": { "type": "string", "minLength": 1 },
        "actor_id": { "type": ["string", "null"] },
        "generation": { "type": ["string", "null"] },
        "workload_ref": { "type": ["string", "null"] },
        "machine_ref": { "type": ["string", "null"] },
        "session_ref": { "type": ["string", "null"] },
        "custody_ref": { "type": ["string", "null"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referent_type", "referent_id", "state_owner_ref"],
      "properties": {
        "referent_type": { "type": "string", "minLength": 1 },
        "referent_id": { "type": "string", "minLength": 1 },
        "state_owner_ref": { "type": ["string", "null"] }
      }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "ttl_seconds": { "type": "integer", "minimum": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": ["string", "null"] },
    "idempotency_key": { "type": ["string", "null"] },
    "authority_class": { "type": "string", "minLength": 1 },
    "authority_ref": { "type": ["string", "null"] },
    "effect_class": { "enum": ["NONE", "READ_ONLY", "WRITE_POSSIBLE", "UNKNOWN"] },
    "reply_to": { "type": ["string", "null"] },
    "requires_ack": { "type": "boolean" },
    "payload_ref": { "type": ["string", "null"] },
    "payload_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "message_type": { "const": "DURABLE_COMMAND" } },
        "required": ["message_type"]
      },
      "then": {
        "properties": {
          "idempotency_key": { "type": "string", "minLength": 1 },
          "authority_ref": { "type": "string", "minLength": 1 },
          "requires_ack": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": { "payload_ref": { "type": "string" } },
        "required": ["payload_ref"]
      },
      "then": {
        "properties": { "payload_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }
      }
    },
    {
      "if": {
        "properties": { "payload_hash": { "type": "string" } },
        "required": ["payload_hash"]
      },
      "then": {
        "properties": { "payload_ref": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
