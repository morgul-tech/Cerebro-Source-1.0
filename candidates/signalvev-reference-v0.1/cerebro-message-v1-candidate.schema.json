{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cerebro:communication:message:v1:draft-no-authority",
  "$comment": "SOURCE PROVENANCE: transcribed verbatim (structure and field-for-field content, not byte-identical rendering) from the CEREBRO_MESSAGE_V1 draft JSON Schema pinned inside 'CEREBRO-Communication-Stack-v01-FULL-HANDOFF.md' (Google Drive file ID 1qoQ0O53D5QVosQLo3-x2wsY8tGhQxXCU), section 3. That document pins this schema's complete source at 3666 bytes / SHA256 432bd83d36c34f81d6875f47931e0d89c5ec3206315c474b7d091982c3f409d1. This candidate file was reconstructed from a Markdown-rendered extraction of that document (pandoc-style escaping of underscores/brackets/bold-markers), not from the raw file bytes, so byte-exact hash equality against the pinned SHA256 has NOT been independently verified here -- see README.md 'Open deviations and assumptions'. STATUS: isolated implementation candidate, no authority, no runtime activation implied.",
  "title": "CEREBRO_MESSAGE_V1 architecture draft",
  "description": "Transport-neutral descriptive envelope. Validation is not identity, authority, admission, effect or canonical state proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "message_type",
    "schema_version",
    "subject",
    "source",
    "target",
    "issued_at",
    "ttl_seconds",
    "trace_id",
